# Keep this server-side. Never prefix it with VITE_.
LIANGPEI_TOKEN=

# Admin password must be stored as a scrypt hash, never plaintext.
ADMIN_PASSWORD_HASH=

# Generate 32 random bytes and encode as base64url. Required before saving an AI key.
CONFIG_ENCRYPTION_KEY=

# Comma-separated HTTPS origins that may receive the provider Bearer key.
AI_ALLOWED_ORIGINS=https://api.openai-next.com

# Cost controls for the public game-generation endpoint.
AI_GENERATION_PER_HOUR=20
AI_FRESH_PER_CONTEXT=2

# PUBLIC_ORIGIN and STATE_DIR have safe local defaults. Production sets them in systemd,
# so do not copy local operational values into /etc/hackathon-chat.env.
